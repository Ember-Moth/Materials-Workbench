#-----------------------------------------------------------------------------
# Site multiplicities in the three ways files state them, in P -1 with Cu1
# on an inversion center. SHELXL-97 writes the site-symmetry order under
# _atom_site_symmetry_multiplicity (2 on the inversion center, 1 on the
# general position), SHELXL-2014 and later write it as
# _atom_site_site_symmetry_order, other programs write the multiplicity of
# International Tables (1 and 2). The importer must accept each and report
# only O1, which has a wrong value in the last two blocks.
# Hand-written test fixture for Materials Workbench (mw-crystal-io); the
# layout follows COD files such as entry 1000004, no values are copied.
#-----------------------------------------------------------------------------

data_shelxl97
_symmetry_space_group_name_H-M    'P -1'
_cell_length_a                    7.0
_cell_length_b                    8.0
_cell_length_c                    9.0
_cell_angle_alpha                 80
_cell_angle_beta                  85
_cell_angle_gamma                 95
loop_
_symmetry_equiv_pos_as_xyz
'x, y, z'
'-x, -y, -z'
loop_
_atom_site_label
_atom_site_type_symbol
_atom_site_fract_x
_atom_site_fract_y
_atom_site_fract_z
_atom_site_occupancy
_atom_site_symmetry_multiplicity
Cu1 Cu 0 0 0 1 2
N1 N 0.1500 0.1200 0.0800 1 1
O1 O 0.3100 0.2500 0.1700 1 1

data_shelxl2014
_space_group_name_H-M_alt         'P -1'
_cell_length_a                    7.0
_cell_length_b                    8.0
_cell_length_c                    9.0
_cell_angle_alpha                 80
_cell_angle_beta                  85
_cell_angle_gamma                 95
loop_
_space_group_symop_operation_xyz
'x, y, z'
'-x, -y, -z'
loop_
_atom_site_label
_atom_site_type_symbol
_atom_site_fract_x
_atom_site_fract_y
_atom_site_fract_z
_atom_site_occupancy
_atom_site_site_symmetry_order
Cu1 Cu 0 0 0 1 2
N1 N 0.1500 0.1200 0.0800 1 1
O1 O 0.3100 0.2500 0.1700 1 2

data_international_tables
_space_group_name_H-M_alt         'P -1'
_cell_length_a                    7.0
_cell_length_b                    8.0
_cell_length_c                    9.0
_cell_angle_alpha                 80
_cell_angle_beta                  85
_cell_angle_gamma                 95
loop_
_space_group_symop_operation_xyz
'x, y, z'
'-x, -y, -z'
loop_
_atom_site_label
_atom_site_type_symbol
_atom_site_fract_x
_atom_site_fract_y
_atom_site_fract_z
_atom_site_occupancy
_atom_site_symmetry_multiplicity
Cu1 Cu 0 0 0 1 1
N1 N 0.1500 0.1200 0.0800 1 2
O1 O 0.3100 0.2500 0.1700 1 1
